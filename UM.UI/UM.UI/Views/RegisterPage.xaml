<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UM.UI.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0F4FF" Offset="0.0" />
                <GradientStop Color="#FCEBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>
        
        <Grid.Resources>
            <ThemeShadow x:Name="SharedShadow" />
        </Grid.Resources>
        
        <Grid x:Name="ShadowReceiver" />

        <ScrollViewer>
            <Grid Padding="0,40">
                <Border Background="White" Width="380" CornerRadius="24" Padding="36"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Shadow="{StaticResource SharedShadow}"
                        Translation="0,0,16">
                    <StackPanel>
                        <!-- Logo -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Grid Width="48" Height="48">
                                <Border Background="#4B4FEF" CornerRadius="14,14,4,14" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border Background="#FF8A65" CornerRadius="14,14,14,4" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Tạo tài khoản mới" FontSize="22" FontWeight="Bold" Foreground="#111" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Chỉ mất một phút để bắt đầu tham gia nhóm" FontSize="14" Foreground="#777" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,32" />

                        <TextBlock Text="Họ và tên" FontSize="13" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8" />
                        <TextBox PlaceholderText="Nguyễn Văn A" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" Margin="0,0,0,16" VerticalContentAlignment="Center" />

                        <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8" />
                        <TextBox PlaceholderText="vidu@email.com" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" Margin="0,0,0,16" VerticalContentAlignment="Center" />

                        <TextBlock Text="Số điện thoại" FontSize="13" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8" />
                        <TextBox PlaceholderText="0901 234 567" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" Margin="0,0,0,16" VerticalContentAlignment="Center" />

                        <TextBlock Text="Ngày sinh" FontSize="13" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8" />
                        <Grid ColumnSpacing="8" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" PlaceholderText="Ngày" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                            <TextBox Grid.Column="1" PlaceholderText="Tháng" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                            <TextBox Grid.Column="2" PlaceholderText="Năm" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8" />
                        <PasswordBox PlaceholderText="Tối thiểu 8 ký tự" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" Margin="0,0,0,16" VerticalContentAlignment="Center" />

                        <TextBlock Text="Xác nhận mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8" />
                        <PasswordBox PlaceholderText="Nhập lại mật khẩu" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" Margin="0,0,0,8" VerticalContentAlignment="Center" />
                        
                        <TextBlock Text="Mật khẩu nên có chữ hoa, chữ thường và số." FontSize="12" Foreground="#888" Margin="0,0,0,24" />

                        <Button Content="Tạo tài khoản" Background="#4B4FEF" Foreground="White" CornerRadius="12" Height="46" HorizontalAlignment="Stretch" FontWeight="SemiBold" Click="Register_Click" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                            <TextBlock Text="Đã có tài khoản?" Foreground="#666" FontSize="14" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Đăng nhập" Foreground="#4B4FEF" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,0" Click="Login_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
