<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UM.UI.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0F4FF" Offset="0.0" />
                <GradientStop Color="#FCEBFF" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>
        
        <Grid.Resources>
            <ThemeShadow x:Name="SharedShadow" />
        </Grid.Resources>
        
        <Grid x:Name="ShadowReceiver" />

        <ScrollViewer>
            <Grid Padding="0,40">
                <Border Background="White" Width="380" CornerRadius="24" Padding="36"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Shadow="{StaticResource SharedShadow}"
                        Translation="0,0,16">
                    <StackPanel>
                        <!-- Icon -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border Background="#F5F6FB" CornerRadius="24" Width="48" Height="48">
                                <TextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Khôi phục mật khẩu" FontSize="22" FontWeight="Bold" Foreground="#111" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Nhập email đã đăng ký, chúng tôi sẽ gửi mã xác nhận" FontSize="14" Foreground="#777" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,32" />

                        <TextBlock Text="Email" FontSize="13" FontWeight="SemiBold" Foreground="#444" Margin="0,0,0,8" />
                        <TextBox PlaceholderText="vidu@email.com" Background="#F5F6FB" BorderThickness="0" CornerRadius="12" Height="44" Margin="0,0,0,32" VerticalContentAlignment="Center" />

                        <Button Content="Gửi mã xác nhận" Background="#4B4FEF" Foreground="White" CornerRadius="12" Height="46" HorizontalAlignment="Stretch" FontWeight="SemiBold" Click="Send_Click" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
                            <TextBlock Text="Nhớ ra rồi?" Foreground="#666" FontSize="14" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Quay lại đăng nhập" Foreground="#4B4FEF" FontSize="14" FontWeight="SemiBold" Margin="4,0,0,0" Click="Login_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
