<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UM.UI.Views.SplashScreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Opacity="0" Background="#EEF1FB">
        <Grid.Resources>
            <Storyboard x:Name="FadeInStoryboard">
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.5"/>
            </Storyboard>
            <Storyboard x:Name="FadeOutStoryboard" Completed="FadeOutStoryboard_Completed">
                <DoubleAnimation Storyboard.TargetName="RootGrid"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.5"/>
            </Storyboard>

            <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="LogoScale"
                                 Storyboard.TargetProperty="ScaleX"
                                 From="1" To="1.05" Duration="0:0:1" AutoReverse="True"/>
                <DoubleAnimation Storyboard.TargetName="LogoScale"
                                 Storyboard.TargetProperty="ScaleY"
                                 From="1" To="1.05" Duration="0:0:1" AutoReverse="True"/>
            </Storyboard>
            
            <Storyboard x:Name="DotsStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0"/>
                <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" BeginTime="0:0:0.4"/>
            </Storyboard>
        </Grid.Resources>

        <!-- Top Left Radial Gradient -->
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="0,0" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#154551E5" Offset="0"/>
                    <GradientStop Color="#004551E5" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>
        
        <!-- Bottom Right Radial Gradient -->
        <Grid>
            <Grid.Background>
                <RadialGradientBrush Center="1,1" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#15FF8A5B" Offset="0"/>
                    <GradientStop Color="#00FF8A5B" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
        </Grid>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <!-- Logo -->
            <Grid Width="80" Height="80" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <!-- Speech bubble -->
                <Border Background="#4551E5" CornerRadius="20,20,4,20" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <!-- Circle -->
                <Border Background="#FF8A5B" CornerRadius="20" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- App Name & Tagline -->
            <TextBlock Text="TeamTalk" FontSize="32" FontWeight="Bold" Foreground="#1A1A1A" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="Kết nối nhóm của bạn, mọi lúc mọi nơi" FontSize="16" Foreground="#666666" HorizontalAlignment="Center"/>

            <!-- Loading Dots -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,32,0,0">
                <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#4551E5" Opacity="0.2"/>
                <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#4551E5" Opacity="0.2"/>
                <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#4551E5" Opacity="0.2"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
