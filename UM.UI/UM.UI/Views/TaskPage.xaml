<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UM.UI.Views.TaskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UM.UI.Models">

    <Page.Resources>

        <!-- Shared DataTemplate for task cards -->
        <DataTemplate x:Key="TaskCardTemplate" x:DataType="models:TaskItem">
            <Border Background="#FAFAFA"
                    BorderBrush="#E8E8E8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,0">
                <StackPanel Spacing="6">
                    <!-- Title -->
                    <TextBlock Text="{x:Bind Title}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               TextWrapping="Wrap"/>

                    <!-- Meta row -->
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <!-- Assignee -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE77B;"
                                      FontSize="12"
                                      Foreground="#888888"/>
                            <TextBlock Text="{x:Bind Assignee}"
                                       FontSize="12"
                                       Foreground="#666666"/>
                        </StackPanel>

                        <!-- Due date -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE787;"
                                      FontSize="12"
                                      Foreground="#888888"/>
                            <TextBlock Text="{x:Bind DueDate}"
                                       FontSize="12"
                                       Foreground="#666666"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <!-- Function icons -->
            <ColumnDefinition Width="72"/>
            <!-- Server images -->
            <ColumnDefinition Width="78"/>
            <!-- Channel sidebar -->
            <ColumnDefinition Width="240"/>
            <!-- Main content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- COLUMN 0: Function Icons                                      -->
        <!-- ============================================================ -->
        <Border Grid.Column="0"
                Background="#F0F0F0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8"
                            Padding="0,16,0,16"
                            HorizontalAlignment="Center">

                    <!-- App logo / Home -->
                    <Border Width="48" Height="48"
                            CornerRadius="12"
                            Background="#1A73E8">
                        <TextBlock Text="UM"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Separator -->
                    <Border Height="2" Width="32"
                            Background="#D0D0D0"
                            CornerRadius="1"
                            Margin="0,4"/>

                    <!-- Feature icons -->
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#E8F0FE">
                        <FontIcon Glyph="&#xE8B7;"
                                  FontSize="18"
                                  Foreground="#1A73E8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#FFF3E0">
                        <FontIcon Glyph="&#xE9D5;"
                                  FontSize="18"
                                  Foreground="#E65100"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#E8F5E9">
                        <FontIcon Glyph="&#xE73E;"
                                  FontSize="18"
                                  Foreground="#2E7D32"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#F3E5F5">
                        <FontIcon Glyph="&#xE716;"
                                  FontSize="18"
                                  Foreground="#7B1FA2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Separator -->
                    <Border Height="2" Width="32"
                            Background="#D0D0D0"
                            CornerRadius="1"
                            Margin="0,4"/>

                    <!-- Add button -->
                    <Border Width="48" Height="48"
                            CornerRadius="24"
                            Background="#FAFAFA"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1.5">
                        <TextBlock Text="+"
                                   Foreground="#888888"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================================================ -->
        <!-- COLUMN 1: Server Images                                       -->
        <!-- ============================================================ -->
        <Border Grid.Column="1"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ServerListPanel"
                            Spacing="14"
                            Padding="0,16,0,16"
                            HorizontalAlignment="Center">
                    <!-- Server items are populated from code-behind -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ============================================================ -->
        <!-- COLUMN 1: Channel Sidebar                                     -->
        <!-- ============================================================ -->
        <Border Grid.Column="2"
                Background="#FAFAFA"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">

                <!-- Header -->
                <Border Grid.Row="0"
                        Padding="16,16,16,12"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Dự án SGU"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1A1A1A"/>
                        <TextBlock Text="Quản lý công việc nhóm"
                                   FontSize="12"
                                   Foreground="#888888"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Channel list -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="8,12,8,12">
                    <StackPanel Spacing="2">

                        <!-- Category: CÔNG VIỆC -->
                        <TextBlock Text="CÔNG VIỆC"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="8,4,0,6"
                                   CharacterSpacing="60"/>

                        <Border x:Name="ChannelTodo"
                                Background="#E8F0FE"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,1"
                                PointerPressed="Channel_PointerPressed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="#" Foreground="#1A73E8" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="todo" Foreground="#1A1A1A" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Border Background="#1A73E8" CornerRadius="8" Padding="6,1" Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TodoBadge" Text="3" Foreground="White" FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ChannelDoing"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,1"
                                PointerPressed="Channel_PointerPressed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="#" Foreground="#888888" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="doing" Foreground="#555555" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Border Background="#888888" CornerRadius="8" Padding="6,1" Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="DoingBadge" Text="2" Foreground="White" FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ChannelDone"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,1"
                                PointerPressed="Channel_PointerPressed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="#" Foreground="#888888" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="done" Foreground="#555555" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <Border Background="#888888" CornerRadius="8" Padding="6,1" Margin="4,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="DoneBadge" Text="2" Foreground="White" FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Height="1" Background="#E8E8E8" Margin="8,10"/>

                        <!-- Category: TRAO ĐỔI -->
                        <TextBlock Text="TRAO ĐỔI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="8,4,0,6"
                                   CharacterSpacing="60"/>

                        <Border Background="Transparent"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="#" Foreground="#888888" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="general" Foreground="#555555" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="#" Foreground="#888888" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="thông-báo" Foreground="#555555" FontSize="14"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Separator -->
                        <Border Height="1" Background="#E8E8E8" Margin="8,10"/>

                        <!-- Category: THÀNH VIÊN -->
                        <TextBlock Text="THÀNH VIÊN"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="8,4,0,6"
                                   CharacterSpacing="60"/>

                        <!-- Members -->
                        <Border Background="Transparent"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#4CAF50">
                                    <TextBlock Text="V" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Vinh" Foreground="#333333" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#2196F3">
                                    <TextBlock Text="H" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hùng" Foreground="#333333" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#FF9800">
                                    <TextBlock Text="L" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Linh" Foreground="#333333" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="Transparent"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#9C27B0">
                                    <TextBlock Text="T" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tuấn" Foreground="#333333" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- COLUMN 2: Main Content Area                                   -->
        <!-- ============================================================ -->
        <Grid Grid.Column="3"
              Background="#FFFFFF"
              RowDefinitions="Auto,*">

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Padding="24,14,24,14"
                    BorderBrush="#E8E8E8"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="#"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CurrentChannelName"
                                   Text="todo"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1A1A"
                                   VerticalAlignment="Center"/>
                        <Border Background="#E8E8E8" Width="1" Height="20" Margin="8,0"/>
                        <TextBlock x:Name="CurrentChannelDescription"
                                   Text="Danh sách công việc cần hoàn thành"
                                   FontSize="13"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Search box -->
                    <AutoSuggestBox x:Name="TaskSearchBox"
                                    Grid.Column="1"
                                    PlaceholderText="Tìm kiếm tin nhắn..."
                                    QueryIcon="Find"
                                    Width="300"
                                    VerticalAlignment="Center"
                                    TextChanged="TaskSearchBox_TextChanged"
                                    QuerySubmitted="TaskSearchBox_QuerySubmitted"/>
                </Grid>
            </Border>

            <!-- Task content area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,16,24,24">
                <StackPanel x:Name="TaskContentPanel" Spacing="28">

                    <!-- ===== SECTION: Todo ===== -->
                    <StackPanel x:Name="TodoSection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="#FFF3E0" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="📋 TODO"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#E65100"/>
                            </Border>
                            <TextBlock x:Name="TodoCountText"
                                       FontSize="12"
                                       Foreground="#AAAAAA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsRepeater x:Name="TodoRepeater"
                                       ItemTemplate="{StaticResource TaskCardTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- ===== SECTION: Doing ===== -->
                    <StackPanel x:Name="DoingSection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="#E8F0FE" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="🔄 DOING"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#1A73E8"/>
                            </Border>
                            <TextBlock x:Name="DoingCountText"
                                       FontSize="12"
                                       Foreground="#AAAAAA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsRepeater x:Name="DoingRepeater"
                                       ItemTemplate="{StaticResource TaskCardTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- ===== SECTION: Done ===== -->
                    <StackPanel x:Name="DoneSection" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Background="#E8F5E9" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="✅ DONE"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#2E7D32"/>
                            </Border>
                            <TextBlock x:Name="DoneCountText"
                                       FontSize="12"
                                       Foreground="#AAAAAA"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsRepeater x:Name="DoneRepeater"
                                       ItemTemplate="{StaticResource TaskCardTemplate}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>